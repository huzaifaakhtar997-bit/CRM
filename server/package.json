{
  "name": "server",
  "version": "1.0.0",
  "description": "HubSpot CRM Backend Foundation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npx ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm install --include=dev && npx prisma generate && npx prisma migrate deploy",
