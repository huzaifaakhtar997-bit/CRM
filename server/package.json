    "@types/multer": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "isomorphic-dompurify": "^3.22.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "resend": "^6.20.0",
    "socket.io": "^4.8.3",
    "svix": "^1.99.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
